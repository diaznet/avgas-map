# Local development credentials for the autorouter WebDAV (portable, OS-agnostic).
# Copy this file to a `.env` at the repository root and fill in your values, OR
# export these variables in your shell. The `.env` is gitignored and must NEVER
# be committed. In CI these come from GitHub Actions secrets, not this file.
#
# Only needed for REAL (non-fixture) local data generation. Fixture/--dry-run
# runs need no credentials.

AUTOROUTER_USER=your-autorouter-account@example.com
AUTOROUTER_PASS=your-password
